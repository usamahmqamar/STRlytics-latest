# ---- SERVER-ONLY (set in Vercel > Project > Settings > Environment Variables) ----
# Never prefix these with VITE_ : anything starting with VITE_ is shipped to every browser.
# GEMINI_API_KEY: used only by the api/ai/* server functions.
GEMINI_API_KEY=
# FIREBASE_PROJECT_ID: used by the server to verify users' sign-in tokens.
FIREBASE_PROJECT_ID=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- PUBLIC (browser) Firebase web config: identifies the project, is not a secret. ----
# Protect it with API-key restrictions and Firebase App Check (see SECURITY.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=
