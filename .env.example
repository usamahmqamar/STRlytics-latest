# Copy to .env.local for local development. Never commit real values.

# --- Browser (public) -------------------------------------------------------
# Firebase is still used until Phase 2 moves data to Supabase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIRESTORE_DATABASE_ID=

# Supabase (Phase 1 onwards)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Vercel functions in /api) ---------------------------------
# Never prefix these with VITE_, or they will be shipped to the browser.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
