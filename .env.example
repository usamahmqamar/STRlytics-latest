# ---- PUBLIC (browser) ----
# Supabase project URL and PUBLISHABLE key (sb_publishable_...). Safe in the browser:
# every table is protected by row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- SERVER-ONLY (Vercel > Project > Settings > Environment Variables) ----
# Never prefix these with VITE_ : anything starting with VITE_ is shipped to every browser.
# GEMINI_API_KEY: used only by the api/ai/* server functions.
GEMINI_API_KEY=
# The AI server functions also read SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY
# (they fall back to the VITE_ values above). No service-role or secret key is needed anywhere.

# Error alerts (optional). Create a project at sentry.io and copy its DSN.
# VITE_SENTRY_DSN is built into the browser app (DSNs are public by design);
# SENTRY_DSN is read by the server functions only.
VITE_SENTRY_DSN=
SENTRY_DSN=

# Reminder emails (daily job). CRON_SECRET: a long random value (at least 32 characters);
# store its SHA-256 in the database as described in supabase/migrations/*_reminder_emails.sql.
# RESEND_API_KEY from resend.com; EMAIL_FROM like "Staylytics <reminders@yourdomain.com>";
# APP_URL is the live site address used in email links.
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
