{
  "name": "strlytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:db": "scripts/db-test.sh",
    "test:security": "esbuild tests/security.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.test-build/security.test.mjs --log-level=warning && node --test .test-build/security.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:unit": "esbuild tests/feasibility.test.ts tests/reconcile.test.ts tests/pl.test.ts tests/export.test.ts --bundle --platform=node --format=esm --packages=external --outdir=.test-build --log-level=warning && node --test .test-build/feasibility.test.js .test-build/reconcile.test.js .test-build/pl.test.js .test-build/export.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
